# =============================================================================
# RENTFLOW SAAS - SUPABASE DATABASE CONFIGURATION
# =============================================================================

# 1. Supabase Project Reference (depuis votre tableau de bord Supabase)
SUPABASE_PROJECT_ID=votre_project_ref
SUPABASE_URL=https://votre_project_ref.supabase.co
SUPABASE_ANON_KEY=votre_cle_anon_publique
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# 2. Connexion Directe PostgreSQL Supabase (Port 5432 ou 6543 pooler)
# Exemple: jdbc:postgresql://db.votre_project_ref.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.votre_project_ref.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=votre_mot_de_passe_choisi
